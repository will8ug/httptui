{
  "openapi": "3.0.3",
  "info": { "title": "Array Primitives API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/tags": {
      "post": {
        "operationId": "setTags",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "type": "string", "example": "priority" }
              }
            }
          }
        }
      }
    }
  }
}
