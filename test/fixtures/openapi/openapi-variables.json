{
  "openapi": "3.0.3",
  "info": { "title": "Variables API", "version": "1.0.0" },
  "servers": [
    {
      "url": "https://{host}/v1",
      "variables": {
        "host": { "default": "api.example.com" }
      }
    }
  ],
  "paths": {
    "/users": {
      "get": { "operationId": "listUsers" }
    }
  }
}
