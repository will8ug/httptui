{
  "openapi": "3.0.3",
  "info": { "title": "Array Ref API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/bulk": {
      "post": {
        "operationId": "bulkCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/LineItem" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LineItem": {
        "type": "object",
        "properties": {
          "sku":      { "type": "string",  "example": "W-001" },
          "quantity": { "type": "integer", "example": 2 }
        }
      }
    }
  }
}
