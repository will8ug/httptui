{
  "openapi": "3.0.3",
  "info": { "title": "Body Ref API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/items": {
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DemoItem" }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Widget" },
          "description": { "type": "string", "example": "A widget" },
          "secret": { "type": "string" }
        }
      }
    }
  }
}
