{
  "openapi": "3.0.3",
  "info": { "title": "Params API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get user by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "example": "active" } },
          { "name": "X-Trace-Id", "in": "header", "schema": { "type": "string" } },
          { "name": "Accept", "in": "header", "schema": { "type": "string", "default": "application/json" } }
        ]
      }
    }
  }
}
