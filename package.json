{
  "name": "httptui",
  "version": "0.7.0",
  "description": "Interactive TUI for sending HTTP requests from .http files",
  "type": "module",
  "bin": {
    "httptui": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/will8ug/httptui.git"
  },
  "bugs": {
    "url": "https://github.com/will8ug/httptui/issues"
  },
  "homepage": "https://github.com/will8ug/httptui",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "cov-badges": "generateBadges --input ./coverage/coverage-summary.json --output ./badges",
    "lint": "eslint src/ test/",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "http",
    "rest",
    "tui",
    "terminal",
    "cli",
    "api",
    "rest-client"
  ],
  "license": "MIT",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.0",
    "postman-collection": "^4.5.0",
    "react": "^19.0.0",
    "undici": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "ink-testing-library": "^4.0.0",
    "node-coverage-badges": "^1.6.3",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
